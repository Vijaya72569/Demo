@model List<EFCoreCurdCodeFirst8.Models.EmpModel>;
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    var Editemp = ViewBag.editemp as EFCoreCurdCodeFirst8.Models.EmpModel;
}
<h1>Emp CURD</h1>
<form method="post" action="@(Editemp!=null? "/Emp/Edit":"/Emp/Create")">
<input type="hidden" name="Eid" value="@(Editemp?.Eid ?? 0)" /> <br />
<label>Ename</label>
<input type="text" name="Name" value="@(Editemp?.Name ??"")" /><br />
    <label>Salary</label>
    <input type="number" name="Salary" value="@(Editemp?.Salary?? 0)" /><br />
    <button type="submit">@(Editemp!=null ? "Update":"Create")</button>
</form>
<table border="1">
    <thead>
        <tr>
            <th>Eid</th>
            <th>Ename</th>
            <th>Salary</th>
            <th colspan="2">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach(var emp in Model)
        {
            <tr>
                <td>@emp.Eid</td>
                 <td>@emp.Name</td>
                <td>@emp.Salary</td>
                <td>
                    <form method="get" action="/Emp/Index">
                    <input type="hidden" name="id" value="@emp.Eid" />
                    <button type="submit">Edit</button>
                    </form>
                </td>
                <td>
                    <form method="post" action="/Emp/Delete">
                    <input type="hidden" name="id" value="@emp.Eid" />
                    <button type="submit">Delete</button>
                    </form>
                </td>
            </tr>

            
        }
    </tbody>
</table>
