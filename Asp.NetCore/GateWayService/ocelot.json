{
  "Routes": [
    {
      "DownstreamPathTemplate": "/api/Emp/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5108 // this your Emp Service running port number 
        }
      ],
      "UpstreamPathTemplate": "/Emp/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST" ]
    },
    {
      "DownstreamPathTemplate": "/api/Student/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",

          "Port": 5187 // this your Student Service running port number
        }
      ],
      "UpstreamPathTemplate": "/Student/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST" ]
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "http://localhost:5184" 
  }
}
